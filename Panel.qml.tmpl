// Generated by mazapan (plugin {{ plugin }}).
//
// Ports: what's listening on this computer, with names a person knows. On
// top, one field: a port number says whether it's free (and the next one
// that is), anything else filters. Below, the listeners as cards, in four
// groups: yours (your servers, with their project), containers, your
// systemd sockets, and the system's (shown, never stopped). Each says how
// far it reaches: this computer, your VPN, the network behind the firewall,
// or open to the network.
//
// ↑ ↓ move, Enter opens it in the browser, Ctrl+C copies its address,
// Ctrl+K stops it (asked once; still there, Ctrl+K again forces it),
// Ctrl+R looks again, Esc clears or closes; so does a click outside.

import QtQuick
import QtQuick.Layouts
import QtQuick.Controls as QQC
import QtQuick.Effects
import Quickshell
import Quickshell.Wayland
import Quickshell.Hyprland
import qs
import "../components/kit"
import "../components/ports"

Item {
  id: root

  property bool open: false
  property var screenAtOpen: null
  readonly property var ps: PortsService

  function toggle() { open ? close() : show() }
  function show() {
    screenAtOpen = Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
    open = true
    armed = ""
    Qt.callLater(() => { ask.forceActiveFocus(); ask.selectAll() })
  }
  function close() { open = false }

  Binding { target: PortsService; property: "panelOpen"; value: root.open }

  // --- what's typed --------------------------------------------------------------------

  readonly property string query: ask.text.trim()
  readonly property int askedPort: /^\d{1,5}$/.test(query) && Number(query) > 0 && Number(query) < 65536 ? Number(query) : 0
  onAskedPortChanged: ps.check(askedPort)

  readonly property var rows: {
    const q = query.toLowerCase()
    if (!q) return ps.shown
    if (askedPort) return ps.shown.filter(i => String(i.port).startsWith(q))
    return ps.shown.filter(i => [i.name, i.project, i.path, i.cmd, i.cwd, i.unit,
      i.container ? i.container.name + " " + i.container.image + " " + i.container.project : ""]
      .some(s => (s || "").toLowerCase().includes(q)))
  }
  readonly property var current: list.currentIndex >= 0 && list.currentIndex < rows.length ? rows[list.currentIndex] : null

  // The row for the port asked, when it's listed: picked.
  onRowsChanged: {
    if (askedPort) {
      const i = rows.findIndex(r => r.port === askedPort)
      list.currentIndex = i
    } else if (list.currentIndex >= rows.length) list.currentIndex = rows.length - 1
  }

  // --- stopping: asked once; still there, forced the next time ---------------------------

  property string armed: ""        // the row asked about: "kind:port"
  function rowKey(i) { return i ? i.kind + ":" + i.port + ":" + i.proto : "" }
  function canStop(i) { return !!i && i.proto === "tcp" && (i.kind === "mine" || i.kind === "container" || (i.kind === "unit" && i.unit)) }
  function forcing(i) { return !!i && !!ps.outcome && ps.outcome.port === i.port && ps.outcome.result === "held" }
  function stop(i) {
    if (!canStop(i) || ps.busy) return
    const k = rowKey(i)
    if (armed !== k) { armed = k; disarm.restart(); return }
    armed = ""
    ps.stop(i.port, forcing(i))
  }
  Timer { id: disarm; interval: 4000; onTriggered: root.armed = "" }

  function copyOf(i) { return i.url || (i.addrs[0] + ":" + i.port) }
  property string copied: ""
  function copy(i) {
    ps.copy(copyOf(i))
    copied = rowKey(i)
    copiedTimer.restart()
  }
  Timer { id: copiedTimer; interval: 1600; onTriggered: root.copied = "" }

  // What came of the last stop, said for a few seconds.
  readonly property string said: {
    const o = ps.outcome
    if (!o) return ""
    const name = o.kind === "mine" && o.project ? o.project : (o.name || {{ tq "unknown" }})
    switch (o.result) {
      case "freed":
        return o.kind === "container" ? {{ tq "out.freed.container" }}.arg(o.port).arg(name)
          : o.watcher ? {{ tq "out.freed.watcher" }}.arg(o.port).arg(name).arg(o.watcher)
          : {{ tq "out.freed" }}.arg(o.port).arg(name)
      case "back": return {{ tq "out.back" }}.arg(o.port).arg(o.by || name)
      case "held": return {{ tq "out.held" }}.arg(o.port).arg(name)
      case "not-yours": return {{ tq "out.notyours" }}.arg(o.port)
      case "free": return {{ tq "out.free" }}.arg(o.port)
      default: return {{ tq "out.failed" }}.arg(name) + (o.error ? "  " + o.error : "")
    }
  }
  readonly property color saidTone: !ps.outcome ? Theme.fg
    : ps.outcome.result === "freed" || ps.outcome.result === "free" ? Theme.success
    : ps.outcome.result === "held" || ps.outcome.result === "back" ? Theme.warning : Theme.danger
  property bool saying: false
  Connections {
    target: PortsService
    function onOutcomeChanged() { if (PortsService.outcome) { root.saying = true; sayTimer.restart() } }
  }
  Timer { id: sayTimer; interval: 7000; onTriggered: root.saying = false }

  // --- the window ------------------------------------------------------------------------

  PanelWindow {
    id: win
    visible: root.open || card.opacity > 0.01
    screen: root.screenAtOpen
    anchors.top: true
    anchors.bottom: true
    anchors.left: true
    anchors.right: true
    color: "transparent"
    exclusionMode: ExclusionMode.Normal
    WlrLayershell.layer: WlrLayer.Overlay
    // "mazapan-panel-…": SUPER + Q closes it (see hypr-base).
    WlrLayershell.namespace: "mazapan-panel-ports"
    WlrLayershell.keyboardFocus: root.open ? WlrKeyboardFocus.Exclusive : WlrKeyboardFocus.None
    mask: Region { item: root.open ? win.contentItem : null }

    // A click anywhere else closes it.
    MouseArea {
      anchors.fill: parent
      enabled: root.open
      acceptedButtons: Qt.AllButtons
      onPressed: root.close()
    }

    RectangularShadow {
      anchors.fill: card
      radius: card.radius
      blur: 40
      offset.y: 14
      opacity: card.opacity
      color: Qt.rgba(0, 0, 0, Theme.mode === "light" ? 0.18 : 0.45)
    }

    Rectangle {
      id: card
      anchors.centerIn: parent
      width: Math.min(parent.width - 48, 980)
      // As tall as what it shows (the header, the field, the answer, the
      // cards, the keys), up to the screen.
      readonly property real chrome: 22 + 44 + 18 + 52 + (answerBox.info ? 68 : 0) + 8 + 12 + 44
      height: Math.min(parent.height - 48, Math.max(380, chrome + list.contentHeight))
      Behavior on height { enabled: Theme.motion && root.open; NumberAnimation { duration: 220; easing.type: Easing.OutCubic } }
      color: Theme.bg
      border.width: 1
      border.color: Theme.border
      radius: Theme.radius
      clip: true

      opacity: root.open ? 1 : 0
      scale: root.open ? 1 : 0.97
      Behavior on opacity { enabled: Theme.motion; NumberAnimation { duration: 200; easing.type: Easing.OutCubic } }
      Behavior on scale { enabled: Theme.motion; NumberAnimation { duration: 260; easing.type: Easing.OutCubic } }

      MouseArea { anchors.fill: parent; acceptedButtons: Qt.AllButtons; onPressed: ask.forceActiveFocus() }

      // A glow of the accent behind the header; the danger's when something is open.
      Rectangle {
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top
        height: 190
        gradient: Gradient {
          GradientStop { position: 0; color: Qt.alpha(ps.open.length ? Theme.danger : Theme.accent, Theme.mode === "light" ? 0.09 : 0.13) }
          GradientStop { position: 1; color: "transparent" }
        }
        Behavior on opacity { enabled: Theme.motion; NumberAnimation { duration: 300 } }
      }

      ColumnLayout {
        anchors.fill: parent
        spacing: 0

        // --- the header ---------------------------------------------------------------
        RowLayout {
          Layout.fillWidth: true
          Layout.leftMargin: 24
          Layout.rightMargin: 24
          Layout.topMargin: 22
          spacing: 14

          Item {
            Layout.preferredWidth: 44
            Layout.preferredHeight: 44
            // A ring that breathes while something is open to the network.
            Rectangle {
              anchors.centerIn: parent
              width: 44
              height: 44
              radius: logo.radius + 4
              color: "transparent"
              border.width: 2
              border.color: Theme.danger
              visible: ps.open.length > 0
              SequentialAnimation on scale {
                running: ps.open.length > 0 && Theme.motion && root.open
                loops: Animation.Infinite
                NumberAnimation { from: 1; to: 1.25; duration: 1100; easing.type: Easing.OutCubic }
                PauseAnimation { duration: 300 }
              }
              SequentialAnimation on opacity {
                running: ps.open.length > 0 && Theme.motion && root.open
                loops: Animation.Infinite
                NumberAnimation { from: 0.8; to: 0; duration: 1100; easing.type: Easing.OutCubic }
                PauseAnimation { duration: 300 }
              }
            }
            Rectangle {
              id: logo
              anchors.centerIn: parent
              width: 40
              height: 40
              radius: Math.min(Theme.radius * 1.5, 12)
              gradient: Gradient {
                GradientStop { position: 0; color: Qt.lighter(ps.open.length ? Theme.danger : Theme.accent, 1.12) }
                GradientStop { position: 1; color: ps.open.length ? Qt.darker(Theme.danger, 1.15) : Theme.accentDeep }
              }
              Text {
                anchors.centerIn: parent
                text: String.fromCodePoint(0xF048D)
                color: Theme.accentFg
                font.family: Theme.fontMono
                font.pixelSize: 20
              }
            }
          }

          ColumnLayout {
            spacing: 1
            Text {
              text: {{ tq "title" }}
              color: Theme.fg
              font.family: Theme.fontMono
              font.pixelSize: Theme.fontSize * 1.75
              font.bold: true
            }
            Text {
              text: !ps.loaded ? {{ tq "looking" }}
                : ps.open.length ? {{ tq "sum.open" }}.arg(ps.count).arg(ps.open.length)
                : {{ tq "sum" }}.arg(ps.count)
              color: ps.open.length ? Theme.danger : Theme.fgMuted
              font.family: Theme.fontMono
              font.pixelSize: Theme.fontSize * 1.05
            }
          }

          Item { Layout.fillWidth: true }

          // The firewall, as it is.
          Chip {
            glyph: String.fromCodePoint(ps.firewall ? 0xF0483 : 0xF099E)
            text: ps.firewall ? {{ tq "fw.on" }} : {{ tq "fw.off" }}
            tone: ps.firewall ? Theme.success : Theme.warning
            visible: ps.loaded
          }
        }

        // --- one field: a port, or words ---------------------------------------------------
        Rectangle {
          Layout.fillWidth: true
          Layout.leftMargin: 24
          Layout.rightMargin: 24
          Layout.topMargin: 18
          Layout.preferredHeight: 52
          radius: Theme.radius
          color: Theme.surface
          border.width: ask.activeFocus ? 2 : 1
          border.color: ask.activeFocus ? Theme.accent : Theme.border
          Behavior on border.color { enabled: Theme.motion; ColorAnimation { duration: 140 } }

          RowLayout {
            anchors.fill: parent
            anchors.leftMargin: 16
            anchors.rightMargin: 12
            spacing: 12
            Text {
              text: String.fromCodePoint(root.askedPort ? 0xF0200 : 0xF0349)
              color: ask.activeFocus ? Theme.accentText : Theme.fgMuted
              font.family: Theme.fontMono
              font.pixelSize: 18
            }
            TextInput {
              id: ask
              Layout.fillWidth: true
              color: Theme.fg
              selectionColor: Theme.selection
              selectedTextColor: Theme.fg
              font.family: Theme.fontMono
              font.pixelSize: Theme.fontSize * 1.4
              clip: true
              focus: true
              Text {
                anchors.fill: parent
                verticalAlignment: Text.AlignVCenter
                visible: ask.text === ""
                text: {{ tq "ask" }}
                color: Theme.fgSubtle
                font: ask.font
                elide: Text.ElideRight
                textFormat: Text.PlainText
              }

              Keys.onPressed: event => {
                const ctrl = event.modifiers & Qt.ControlModifier
                const i = root.current
                if (event.key === Qt.Key_Escape) {
                  if (ask.text) ask.text = ""
                  else root.close()
                } else if (event.key === Qt.Key_Down) {
                  list.currentIndex = Math.min(root.rows.length - 1, list.currentIndex + 1)
                } else if (event.key === Qt.Key_Up) {
                  list.currentIndex = Math.max(root.rows.length ? 0 : -1, list.currentIndex - 1)
                } else if (event.key === Qt.Key_Return || event.key === Qt.Key_Enter) {
                  if (i && i.url) ps.openUrl(i.url)
                  else if (root.askedPort && ps.answer && ps.answer.free) ps.copy(root.askedPort)
                } else if (ctrl && event.key === Qt.Key_C && i) {
                  root.copy(i)
                } else if (ctrl && event.key === Qt.Key_K && i) {
                  root.stop(i)
                } else if (ctrl && event.key === Qt.Key_R) {
                  ps.refresh()
                  if (root.askedPort) ps.check(root.askedPort)
                } else return
                event.accepted = true
              }
            }
            Text {
              visible: ask.text !== ""
              text: String.fromCodePoint(0xF0156)
              color: clearHover.hovered ? Theme.fg : Theme.fgSubtle
              font.family: Theme.fontMono
              font.pixelSize: 16
              HoverHandler { id: clearHover; cursorShape: Qt.PointingHandCursor }
              TapHandler { onTapped: { ask.text = ""; ask.forceActiveFocus() } }
            }
          }
        }

        // --- the answer, for a port typed --------------------------------------------------
        Answer {
          id: answerBox
          Layout.fillWidth: true
          Layout.leftMargin: 24
          Layout.rightMargin: 24
          Layout.topMargin: 10
          info: ps.answer && ps.answer.port === root.askedPort ? ps.answer : null
        }

        // --- the listeners -------------------------------------------------------------------
        ListView {
          id: list
          Layout.fillWidth: true
          Layout.fillHeight: true
          Layout.topMargin: 8
          Layout.bottomMargin: 12
          Layout.leftMargin: 16
          Layout.rightMargin: 16
          clip: true
          spacing: 6
          currentIndex: -1
          model: root.rows
          boundsBehavior: Flickable.StopAtBounds
          highlightFollowsCurrentItem: false
          QQC.ScrollBar.vertical: QQC.ScrollBar { policy: QQC.ScrollBar.AsNeeded }

          // Each group's heading goes with its first card.
          delegate: Column {
            id: cell
            required property var modelData
            required property int index
            width: list.width
            spacing: 6
            SectionHead {
              width: cell.width
              kind: cell.modelData.kind
              visible: cell.index === 0 || root.rows[cell.index - 1].kind !== cell.modelData.kind
            }
            Listener {
              width: cell.width
              item: cell.modelData
              current: cell.ListView.isCurrentItem
              onPicked: { list.currentIndex = cell.index; ask.forceActiveFocus() }
            }
          }

          add: Transition {
            enabled: Theme.motion
            NumberAnimation { property: "opacity"; from: 0; to: 1; duration: 220 }
            NumberAnimation { property: "x"; from: 12; to: 0; duration: 260; easing.type: Easing.OutCubic }
          }
          displaced: Transition {
            enabled: Theme.motion
            NumberAnimation { properties: "y"; duration: 220; easing.type: Easing.OutCubic }
          }

          // Nothing to show.
          ColumnLayout {
            anchors.centerIn: parent
            visible: ps.loaded && root.rows.length === 0
            spacing: 10
            Text {
              Layout.alignment: Qt.AlignHCenter
              text: String.fromCodePoint(root.query ? 0xF0349 : 0xF048D)
              color: Theme.fgSubtle
              font.family: Theme.fontMono
              font.pixelSize: 54
              opacity: 0.6
            }
            Text {
              Layout.alignment: Qt.AlignHCenter
              text: root.askedPort ? {{ tq "empty.port" }}.arg(root.askedPort)
                : root.query ? {{ tq "empty.query" }}.arg(root.query) : {{ tq "empty" }}
              color: Theme.fg
              font.family: Theme.fontMono
              font.pixelSize: Theme.fontSize * 1.3
              font.bold: true
              textFormat: Text.PlainText
            }
            Text {
              Layout.alignment: Qt.AlignHCenter
              visible: !root.query
              text: {{ tq "empty.more" }}
              color: Theme.fgMuted
              font.family: Theme.fontMono
              font.pixelSize: Theme.fontSize * 1.05
            }
          }
        }

        // --- what came of a stop, and the keys --------------------------------------------------
        Item {
          Layout.fillWidth: true
          Layout.preferredHeight: 44

          Rectangle {
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.leftMargin: 24
            anchors.rightMargin: 24
            anchors.verticalCenter: parent.verticalCenter
            height: 32
            radius: Theme.radius
            color: Qt.alpha(root.saidTone, 0.13)
            border.width: 1
            border.color: Qt.alpha(root.saidTone, 0.5)
            opacity: root.saying && root.said ? 1 : 0
            visible: opacity > 0.01
            Behavior on opacity { enabled: Theme.motion; NumberAnimation { duration: 220 } }
            RowLayout {
              anchors.fill: parent
              anchors.leftMargin: 12
              anchors.rightMargin: 12
              spacing: 8
              Text {
                text: String.fromCodePoint(ps.outcome && (ps.outcome.result === "freed" || ps.outcome.result === "free") ? 0xF012C : 0xF0026)
                color: root.saidTone
                font.family: Theme.fontMono
                font.pixelSize: 14
              }
              Text {
                Layout.fillWidth: true
                text: root.said
                color: Theme.fg
                elide: Text.ElideRight
                font.family: Theme.fontMono
                font.pixelSize: Theme.fontSize * 1.02
                textFormat: Text.PlainText
              }
            }
          }

          Caption {
            anchors.centerIn: parent
            width: parent.width - 48
            opacity: root.saying && root.said ? 0 : 1
            Behavior on opacity { enabled: Theme.motion; NumberAnimation { duration: 220 } }
            text: {{ tq "keys" }}
            font.letterSpacing: 0
            color: Theme.fgSubtle
            horizontalAlignment: Text.AlignHCenter
            elide: Text.ElideRight
          }
        }
      }
    }
  }

  // --- pieces of this panel -------------------------------------------------------------------

  // A small rounded label with a glyph, in a tone.
  component Chip: Rectangle {
    id: chip
    property string glyph: ""
    property string text: ""
    property color tone: Theme.fgMuted
    property bool pulse: false
    implicitHeight: 26
    implicitWidth: chipRow.implicitWidth + 20
    radius: Theme.radius > 0 ? 13 : 0
    color: Qt.alpha(tone, 0.13)
    border.width: 1
    border.color: Qt.alpha(tone, 0.45)
    Row {
      id: chipRow
      anchors.centerIn: parent
      spacing: 6
      Text {
        anchors.verticalCenter: parent.verticalCenter
        text: chip.glyph
        color: chip.tone
        font.family: Theme.fontMono
        font.pixelSize: 13
        SequentialAnimation on opacity {
          running: chip.pulse && Theme.motion && root.open
          loops: Animation.Infinite
          NumberAnimation { to: 0.3; duration: 700 }
          NumberAnimation { to: 1; duration: 700 }
        }
      }
      Text {
        anchors.verticalCenter: parent.verticalCenter
        text: chip.text
        color: Theme.fg
        font.family: Theme.fontMono
        font.pixelSize: Theme.fontSize * 0.95
        textFormat: Text.PlainText
      }
    }
  }

  // How far a listener reaches, as a chip.
  component Reach: Chip {
    property var item: ({})
    readonly property string how: item.exposure === "open" ? "open" : item.exposure === "firewall" ? "firewall" : item.reach === "vpn" ? "vpn" : "local"
    glyph: String.fromCodePoint(how === "open" ? 0xF059F : how === "firewall" ? 0xF0483 : how === "vpn" ? 0xF0582 : 0xF0322)
    text: how === "open" ? {{ tq "reach.open" }} : how === "firewall" ? {{ tq "reach.firewall" }} : how === "vpn" ? {{ tq "reach.vpn" }} : {{ tq "reach.local" }}
    tone: how === "open" ? Theme.danger : how === "firewall" ? Theme.warning : how === "vpn" ? Theme.info : Theme.fgSubtle
    pulse: how === "open"
  }

  // A group's heading: what it is, how many, a word on it.
  component SectionHead: Item {
    id: head
    property string kind: ""
    readonly property int n: root.rows.filter(i => i.kind === kind).length
    implicitHeight: 34
    RowLayout {
      anchors.fill: parent
      anchors.leftMargin: 8
      anchors.rightMargin: 8
      anchors.topMargin: 8
      spacing: 8
      Caption {
        text: (head.kind === "mine" ? {{ tq "g.mine" }} : head.kind === "container" ? {{ tq "g.container" }}
          : head.kind === "unit" ? {{ tq "g.unit" }} : {{ tq "g.system" }}).toUpperCase()
      }
      Rectangle {
        implicitWidth: countText.implicitWidth + 12
        implicitHeight: 18
        radius: 9
        color: Qt.alpha(Theme.fg, 0.07)
        Text {
          id: countText
          anchors.centerIn: parent
          text: head.n
          color: Theme.fgMuted
          font.family: Theme.fontMono
          font.pixelSize: Theme.fontSize * 0.85
        }
      }
      Caption {
        Layout.fillWidth: true
        text: head.kind === "system" ? {{ tq "g.system.note" }} : head.kind === "container" ? {{ tq "g.container.note" }} : ""
        color: Theme.fgSubtle
        font.letterSpacing: 0
        elide: Text.ElideRight
      }
    }
  }

  // A round button with a glyph; a word beside it when it has one.
  component Act: Rectangle {
    id: act
    property string glyph: ""
    property string text: ""
    property color tone: Theme.fg
    property bool filled: false
    property bool spinning: false
    signal clicked()
    implicitHeight: 32
    implicitWidth: text ? actRow.implicitWidth + 22 : 32
    radius: Theme.radius > 0 ? 16 : 0
    color: filled ? tone : actHover.hovered ? Qt.alpha(tone, 0.14) : Qt.alpha(Theme.fg, 0.05)
    border.width: 1
    border.color: filled ? tone : actHover.hovered ? Qt.alpha(tone, 0.6) : Theme.border
    Behavior on color { enabled: Theme.motion; ColorAnimation { duration: 130 } }
    Behavior on implicitWidth { enabled: Theme.motion; NumberAnimation { duration: 160; easing.type: Easing.OutCubic } }
    Row {
      id: actRow
      anchors.centerIn: parent
      spacing: 6
      Text {
        id: actGlyph
        anchors.verticalCenter: parent.verticalCenter
        text: act.glyph
        color: act.filled ? Theme.bg : act.tone
        font.family: Theme.fontMono
        font.pixelSize: 15
        RotationAnimation on rotation {
          running: act.spinning
          from: 0; to: 360; duration: 900
          loops: Animation.Infinite
          onRunningChanged: if (!running) actGlyph.rotation = 0
        }
      }
      Text {
        anchors.verticalCenter: parent.verticalCenter
        visible: act.text !== ""
        text: act.text
        color: act.filled ? Theme.bg : act.tone
        font.family: Theme.fontMono
        font.pixelSize: Theme.fontSize * 0.98
        font.bold: act.filled
      }
    }
    HoverHandler { id: actHover; cursorShape: Qt.PointingHandCursor }
    TapHandler { onTapped: act.clicked() }
  }

  // A listener, as a card.
  component Listener: Rectangle {
    id: row
    property var item: ({})
    property bool current: false
    signal picked()
    readonly property bool system: item.kind === "system"
    readonly property bool hot: current || rowHover.hovered
    readonly property string key: root.rowKey(item)
    readonly property bool busy: PortsService.busy === item.port
    readonly property color tint: item.kind === "mine" ? Theme.accent : item.kind === "container" ? Theme.info : Theme.fgMuted

    implicitHeight: 66
    radius: Theme.radius
    color: current ? Qt.alpha(Theme.accent, 0.10) : rowHover.hovered ? Theme.surfaceRaised : Theme.surface
    border.width: 1
    border.color: current ? Qt.alpha(Theme.accent, 0.6) : item.exposure === "open" && !system ? Qt.alpha(Theme.danger, 0.45) : Theme.border
    opacity: busy ? 0.6 : system ? 0.82 : 1
    Behavior on color { enabled: Theme.motion; ColorAnimation { duration: 140 } }
    Behavior on opacity { enabled: Theme.motion; NumberAnimation { duration: 200 } }

    Rectangle {
      visible: row.current
      x: 0
      width: 3
      height: parent.height - 18
      anchors.verticalCenter: parent.verticalCenter
      radius: 1.5
      color: Theme.accent
    }

    RowLayout {
      anchors.fill: parent
      anchors.leftMargin: 16
      anchors.rightMargin: 12
      spacing: 14

      // The port, big.
      Text {
        Layout.preferredWidth: 78
        text: row.item.port
        color: row.system ? Theme.fgMuted : Theme.fg
        font.family: Theme.fontMono
        font.pixelSize: Theme.fontSize * 1.65
        font.bold: true
      }

      // What it is: its language or tool.
      Rectangle {
        Layout.preferredWidth: 36
        Layout.preferredHeight: 36
        radius: Math.min(Theme.radius, 10)
        color: Qt.alpha(row.tint, 0.14)
        border.width: 1
        border.color: Qt.alpha(row.tint, 0.3)
        Text {
          anchors.centerIn: parent
          text: PortsService.glyph(row.item)
          color: row.item.kind === "mine" ? Theme.accentText : row.tint
          font.family: Theme.fontMono
          font.pixelSize: 18
        }
      }

      ColumnLayout {
        Layout.fillWidth: true
        spacing: 3
        RowLayout {
          Layout.fillWidth: true
          spacing: 8
          Text {
            text: PortsService.label(row.item) + (row.item.guess ? "?" : "")
            color: Theme.fg
            font.family: Theme.fontMono
            font.pixelSize: Theme.fontSize * 1.18
            font.bold: true
            elide: Text.ElideRight
            Layout.maximumWidth: 260
            textFormat: Text.PlainText
          }
          // The tool, beside its project (shop-api · vite).
          Rectangle {
            visible: tool.text !== ""
            implicitWidth: tool.implicitWidth + 14
            implicitHeight: 20
            radius: 10
            color: Qt.alpha(row.tint, 0.12)
            Text {
              id: tool
              anchors.centerIn: parent
              text: row.item.kind === "mine" && row.item.project ? row.item.name
                : row.item.container ? (row.item.container.project ? row.item.container.project : row.item.container.engine)
                : row.item.proto === "udp" ? "UDP" : ""
              color: row.item.kind === "mine" ? Theme.accentText : row.tint
              font.family: Theme.fontMono
              font.pixelSize: Theme.fontSize * 0.88
              textFormat: Text.PlainText
            }
          }
          Item { Layout.fillWidth: true }
        }
        Text {
          Layout.fillWidth: true
          text: {
            const i = row.item
            if (i.kind === "mine") return [i.path || i.cwd, PortsService.since(i.since),
              i.watcher ? {{ tq "watched" }}.arg(i.watcher) : ""].filter(s => s).join("  ·  ")
            if (i.kind === "container") return [i.container.image, i.container.devdb ? {{ tq "devdb" }} : "", i.container.name !== row.item.name ? i.container.name : ""].filter(s => s).join("  ·  ")
            if (i.kind === "unit") return i.unit + "  ·  systemd"
            return i.guess ? {{ tq "guess" }} : {{ tq "notyours" }}
          }
          color: Theme.fgMuted
          elide: Text.ElideMiddle
          font.family: Theme.fontMono
          font.pixelSize: Theme.fontSize * 0.95
          textFormat: Text.PlainText
        }
      }

      Reach { item: row.item }

      // What can be done, shown when it's pointed at or picked.
      Row {
        spacing: 6
        opacity: row.hot || row.busy || root.armed === row.key ? 1 : 0
        visible: opacity > 0.01
        Behavior on opacity { enabled: Theme.motion; NumberAnimation { duration: 140 } }
        Act {
          visible: row.item.url !== ""
          glyph: String.fromCodePoint(0xF03CC)
          onClicked: PortsService.openUrl(row.item.url)
        }
        Act {
          glyph: String.fromCodePoint(root.copied === row.key ? 0xF012C : 0xF018F)
          tone: root.copied === row.key ? Theme.success : Theme.fg
          onClicked: root.copy(row.item)
        }
        Act {
          visible: root.canStop(row.item)
          glyph: String.fromCodePoint(row.busy ? 0xF0453 : 0xF04DB)
          spinning: row.busy && Theme.motion
          tone: Theme.danger
          filled: root.armed === row.key
          text: row.busy ? {{ tq "stopping" }} : root.armed === row.key ? (root.forcing(row.item) ? {{ tq "force" }} : {{ tq "stop.sure" }}) : ""
          onClicked: { row.picked(); root.stop(row.item) }
        }
      }
    }

    HoverHandler { id: rowHover }
    TapHandler {
      onTapped: row.picked()
      onDoubleTapped: PortsService.openUrl(row.item.url)
    }
  }

  // The answer to "is this port free?".
  component Answer: Rectangle {
    id: ans
    property var info: null
    readonly property bool free: !!info && info.free
    readonly property var holder: info && info.holders.length ? info.holders[0] : null
    readonly property color tone: !info ? Theme.border : free ? Theme.success : info.root && !holder ? Theme.info : Theme.warning
    implicitHeight: info ? 58 : 0
    opacity: info ? 1 : 0
    visible: implicitHeight > 0.5
    clip: true
    radius: Theme.radius
    color: Qt.alpha(tone, 0.11)
    border.width: 1
    border.color: Qt.alpha(tone, 0.5)
    Behavior on implicitHeight { enabled: Theme.motion; NumberAnimation { duration: 200; easing.type: Easing.OutCubic } }
    Behavior on opacity { enabled: Theme.motion; NumberAnimation { duration: 180 } }

    RowLayout {
      anchors.fill: parent
      anchors.leftMargin: 16
      anchors.rightMargin: 10
      spacing: 12
      Rectangle {
        Layout.preferredWidth: 30
        Layout.preferredHeight: 30
        radius: 15
        color: ans.tone
        Text {
          anchors.centerIn: parent
          text: String.fromCodePoint(ans.free ? 0xF012C : ans.info && ans.info.root && !ans.holder ? 0xF033E : 0xF0156)
          color: Theme.bg
          font.family: Theme.fontMono
          font.pixelSize: 16
          font.bold: true
        }
      }
      ColumnLayout {
        Layout.fillWidth: true
        spacing: 1
        Text {
          text: !ans.info ? "" : ans.free ? {{ tq "a.free" }}.arg(ans.info.port)
            : ans.holder ? {{ tq "a.taken" }}.arg(ans.info.port).arg(PortsService.label(ans.holder))
            : ans.info.root ? {{ tq "a.root" }}.arg(ans.info.port) : {{ tq "a.busy" }}.arg(ans.info.port)
          color: Theme.fg
          font.family: Theme.fontMono
          font.pixelSize: Theme.fontSize * 1.2
          font.bold: true
          textFormat: Text.PlainText
        }
        Text {
          Layout.fillWidth: true
          text: !ans.info ? "" : ans.free ? {{ tq "a.free.more" }}
            : ans.info.next ? {{ tq "a.next" }}.arg(ans.info.next) : ""
          visible: text !== ""
          color: Theme.fgMuted
          font.family: Theme.fontMono
          font.pixelSize: Theme.fontSize * 0.98
          elide: Text.ElideRight
        }
      }
      Act {
        visible: !!ans.info && !ans.free && ans.info.next > 0
        glyph: String.fromCodePoint(0xF018F)
        text: {{ tq "a.copy" }}.arg(ans.info ? ans.info.next : 0)
        tone: Theme.success
        onClicked: PortsService.copy(ans.info.next)
      }
      Act {
        visible: !!ans.holder && root.canStop(ans.holder)
        glyph: String.fromCodePoint(PortsService.busy === (ans.info ? ans.info.port : -1) ? 0xF0453 : 0xF04DB)
        spinning: PortsService.busy === (ans.info ? ans.info.port : -1) && Theme.motion
        tone: Theme.danger
        filled: !!ans.holder && root.armed === root.rowKey(ans.holder)
        text: !ans.holder ? "" : PortsService.busy === ans.info.port ? {{ tq "stopping" }}
          : root.armed === root.rowKey(ans.holder) ? (root.forcing(ans.holder) ? {{ tq "force" }} : {{ tq "stop.sure" }}) : {{ tq "a.stop" }}
        onClicked: root.stop(ans.holder)
      }
      Act {
        visible: ans.free
        glyph: String.fromCodePoint(0xF018F)
        text: {{ tq "a.copy" }}.arg(ans.info ? ans.info.port : 0)
        tone: Theme.success
        onClicked: PortsService.copy(ans.info.port)
      }
    }
  }
}
