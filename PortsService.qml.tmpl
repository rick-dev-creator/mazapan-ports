// Generated by mazapan (plugin {{ plugin }}): what's listening, for the shell.
//
// The helper (~/.local/share/mazapan/bin/ports) reads it from the kernel and
// says it as JSON: your servers with their project, containers, your systemd
// sockets, the system's. This asks it now and then (often while the panel is
// open), says once when something of yours opens to the network, and runs
// what's pressed: is a port free, stop what holds it.

pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io
import qs

Singleton {
  id: root

  // --- the settings, read live ------------------------------------------------

  readonly property var settings: Object.assign({ bar: true, warn: true, system: true, udp: false, hidden: [53, 631, 5353, 5355], every: 10 }, stored)
  property var stored: ({})
  FileView {
    path: Quickshell.shellPath("components/ports/settings.json")
    blockLoading: true
    watchChanges: true
    printErrors: false
    onFileChanged: reload()
    onLoaded: { try { root.stored = JSON.parse(text()) } catch (e) {} }
  }

  // --- what's listening -----------------------------------------------------------

  readonly property string bin: Quickshell.env("HOME") + "/.local/share/mazapan/bin/ports"
  property var all: []
  property bool firewall: false
  property bool loaded: false
  property bool panelOpen: false

  readonly property var listed: all.filter(i => !(settings.hidden || []).includes(i.port))
  readonly property var mine: listed.filter(i => i.kind === "mine")
  readonly property var boxes: listed.filter(i => i.kind === "container")
  readonly property var units: listed.filter(i => i.kind === "unit")
  readonly property var others: settings.system ? listed.filter(i => i.kind === "system") : []
  readonly property var shown: mine.concat(boxes, units, others)
  // What the bar counts: what you started (servers and containers).
  readonly property int count: mine.length + boxes.length
  // Yours, and anyone on this network can reach it.
  readonly property var open: listed.filter(i => i.exposure === "open" && i.kind !== "system")

  Process {
    id: lister
    command: ["python3", "-I", root.bin, "list"].concat(root.settings.udp ? ["--udp"] : [])
    stdout: StdioCollector {
      onStreamFinished: {
        try {
          const d = JSON.parse(text)
          root.all = d.listeners || []
          root.firewall = !!d.firewall
          root.loaded = true
          root.tell()
        } catch (e) {}
      }
    }
  }
  function refresh() { if (!lister.running) lister.running = true }

  // Every few seconds with the panel open; with it closed, only for the bar
  // and the warning, and only if they're on.
  Timer {
    interval: root.panelOpen ? 2500 : Math.max(5, root.settings.every) * 1000
    running: root.panelOpen || root.settings.bar || root.settings.warn
    repeat: true
    triggeredOnStart: true
    onTriggered: root.refresh()
  }
  onPanelOpenChanged: if (panelOpen) refresh()

  // --- open to the network: said once --------------------------------------------

  property var told: ({})
  function keyOf(i) { return i.kind + ":" + i.port + ":" + i.proto + ":" + (i.container ? i.container.id : i.pid) }
  function tell() {
    const now = {}
    for (const i of open) {
      const k = keyOf(i)
      now[k] = true
      if (told[k] || !settings.warn) continue
      Quickshell.execDetached(["notify-send", "-a", {{ tq "title" }}, "-i", "network-wired",
        {{ tq "warn.title" }}.arg(label(i)).arg(i.port), why(i)])
    }
    // Closed and opened again: said again.
    told = now
  }

  // Why it's open, in a sentence.
  function why(i) {
    if (i.container && i.container.engine === "docker") return {{ tq "why.docker" }}
    return {{ tq "why.nofirewall" }}
  }

  // --- is it free ---------------------------------------------------------------------

  property var answer: null        // { port, free, root, holders, next }
  property int asking: 0
  Process {
    id: checker
    property int ask: 0
    stdout: StdioCollector {
      onStreamFinished: {
        if (checker.ask !== root.asking) return
        try { root.answer = JSON.parse(text) } catch (e) {}
      }
    }
  }
  function check(port) {
    asking++
    if (!port) { answer = null; return }
    checker.running = false
    checker.ask = asking
    checker.command = ["python3", "-I", bin, "check", String(port)]
    checker.running = true
  }

  // --- stopping -------------------------------------------------------------------------

  property int busy: 0             // the port being stopped
  property var outcome: null       // { port, result, name, project, kind, watcher, by, at }
  Process {
    id: stopper
    stdout: StdioCollector {
      onStreamFinished: {
        try { root.outcome = Object.assign(JSON.parse(text), { at: Date.now() }) }
        catch (e) { root.outcome = { port: root.busy, result: "failed", at: Date.now() } }
        root.busy = 0
        root.refresh()
        if (root.answer) root.check(root.answer.port)
      }
    }
  }
  function stop(port, force) {
    if (busy) return
    busy = port
    outcome = null
    stopper.command = ["python3", "-I", bin, "stop", String(port)].concat(force ? ["--force"] : [])
    stopper.running = true
  }

  function openUrl(url) { if (url) Quickshell.execDetached(["xdg-open", url]) }
  function copy(text) { Quickshell.execDetached(["wl-copy", "--", String(text)]) }

  IpcHandler {
    target: "ports"
    function refresh(): void { root.refresh() }
  }

  // --- how things are said ----------------------------------------------------------

  // What a listener is called: its project when it has one (shop-api), else
  // its own name (vite, PostgreSQL), else the port's usual service, guessed.
  function label(i) {
    if (!i) return ""
    if (i.kind === "mine" && i.project) return i.project
    if (i.container && i.container.devdb) return i.container.devdb
    return i.name || {{ tq "unknown" }}
  }

  function since(ts) {
    if (!ts) return ""
    const d = Math.max(0, Date.now() / 1000 - ts)
    if (d < 60) return {{ tq "up.now" }}
    if (d < 3600) return {{ tq "up.min" }}.arg(Math.floor(d / 60))
    if (d < 86400) return {{ tq "up.hour" }}.arg(Math.floor(d / 3600))
    return {{ tq "up.day" }}.arg(Math.floor(d / 86400))
  }

  // Its icon: the language or tool it is, when that can be told.
  function glyph(i) {
    const cp = c => String.fromCodePoint(c)
    if (i.kind === "container") return i.container && i.container.devdb ? cp(0xF01BC) : cp(0xF0868)
    if (i.kind === "unit") return cp(0xF0493)
    if (i.kind === "system") return cp(0xF048B)
    const s = (i.name + " " + i.cmd).toLowerCase()
    const has = words => words.some(w => s.includes(w))
    if (has(["dotnet"]) || /\.dll\b/.test(s)) return cp(0xF0AAE)
    if (has(["node", "vite", "next", "nuxt", "astro", "remix", "webpack", "expo", "metro", "storybook", "npm", "pnpm", "yarn", "tsx"])) return cp(0xF0399)
    if (has(["python", "uvicorn", "gunicorn", "django", "flask", "http.server", "jupyter", "streamlit", "gradio", "mkdocs"])) return cp(0xF0320)
    if (has(["cargo", "rust"])) return cp(0xF1617)
    if (has(["java", "gradle", "mvn", ".jar"])) return cp(0xF0B37)
    if (has(["ruby", "rails", "puma", "jekyll"])) return cp(0xF0D2D)
    if (has(["php", "laravel", "artisan"])) return cp(0xF031F)
    if (has(["qemu", "virt"])) return cp(0xF0379)
    if (/(^|\/)go(\s|$)/.test(s) || has(["air "])) return cp(0xF07D3)
    return cp(0xF018D)
  }
}
