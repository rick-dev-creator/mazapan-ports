// Generated by mazapan (plugin {{ plugin }}): your servers, in the bar.
//
// Its mark and how many servers and containers of yours are listening;
// in the danger's color, with a dot that breathes, while one of them is
// open to the network. Nothing listening: not in the bar. A click opens the
// panel; a right click looks again.

import QtQuick
import Quickshell
import qs
import "../../components/kit"
import "../../components/ports"

BarItem {
  id: root

  readonly property bool exposed: PortsService.open.length > 0
  shown: PortsService.settings.bar && (PortsService.count > 0 || exposed)
  acceptedButtons: Qt.LeftButton | Qt.RightButton
  onClicked: mouse => {
    if (mouse.button === Qt.RightButton) PortsService.refresh()
    else Quickshell.execDetached(["qs", "ipc", "-c", "mazapan", "call", "mazapan", "panel", "ports"])
  }

  Item {
    anchors.verticalCenter: parent.verticalCenter
    width: mark.implicitWidth
    height: mark.implicitHeight
    Text {
      id: mark
      text: String.fromCodePoint(0xF048D)
      color: root.exposed ? Theme.danger : Theme.fgMuted
      font.family: Theme.fontMono
      font.pixelSize: Theme.fontSize * 1.35
    }
    Rectangle {
      visible: root.exposed
      anchors.right: parent.right
      anchors.top: parent.top
      anchors.rightMargin: -2
      width: 6
      height: 6
      radius: 3
      color: Theme.danger
      SequentialAnimation on opacity {
        running: root.exposed && Theme.motion
        loops: Animation.Infinite
        NumberAnimation { to: 0.25; duration: 800; easing.type: Easing.InOutSine }
        NumberAnimation { to: 1; duration: 800; easing.type: Easing.InOutSine }
      }
    }
  }

  Text {
    anchors.verticalCenter: parent.verticalCenter
    text: PortsService.count
    color: root.exposed ? Theme.danger : Theme.fg
    font.family: Theme.fontMono
    font.pixelSize: Theme.fontSize * 1.2
  }
}
