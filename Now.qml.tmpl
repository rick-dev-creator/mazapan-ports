// Generated by mazapan (plugin {{ plugin }}): open to the network, in the
// Control Center.
//
// While a server or a container of yours can be reached by anyone on this
// network (the firewall off, or Docker publishing past it): a card under
// Now that says which and why, with Stop right there, and the pill says it.

import QtQuick
import QtQuick.Layouts
import Quickshell
import qs
import "../../components/kit"
import "../../components/ports"
import "../../components/control"

Group {
  id: root

  readonly property var first: PortsService.open.length ? PortsService.open[0] : null
  readonly property bool live: PortsService.settings.warn && !!first
  readonly property int level: 1
  readonly property string pill: first ? {{ tq "pill" }}.arg(first.port) : ""

  color: Qt.rgba(Theme.danger.r, Theme.danger.g, Theme.danger.b, 0.12)
  border.color: Theme.danger

  RowLayout {
    Layout.fillWidth: true
    spacing: 10
    Glyph {
      text: String.fromCodePoint(0xF059F)
      color: Theme.danger
      font.pointSize: 15
    }
    ColumnLayout {
      Layout.fillWidth: true
      spacing: 2
      Label {
        text: root.first ? (PortsService.open.length > 1
          ? {{ tq "now.many" }}.arg(PortsService.open.length)
          : {{ tq "warn.title" }}.arg(PortsService.label(root.first)).arg(root.first.port)) : ""
        font.bold: true
        textFormat: Text.PlainText
        wrapMode: Text.Wrap
        Layout.fillWidth: true
      }
      Caption {
        text: root.first ? PortsService.why(root.first) : ""
        font.letterSpacing: 0
        wrapMode: Text.Wrap
        Layout.fillWidth: true
      }
    }
    Button {
      visible: !!root.first && PortsService.open.length === 1 && root.first.proto === "tcp"
      primary: true
      text: {{ tq "a.stop" }}
      onClicked: PortsService.stop(root.first.port, false)
    }
    Button {
      text: "󰅂"
      onClicked: {
        ControlService.close()
        Quickshell.execDetached(["qs", "ipc", "-c", "mazapan", "call", "mazapan", "panel", "ports"])
      }
    }
  }
}
