#!/usr/bin/env python3
# Generated by mazapan (plugin {{ plugin }}): what's listening on this
# computer, and stopping it.
#
#   ports list [--udp]          every listener, as JSON
#   ports check PORT            free? who holds it, and the next free one
#   ports stop PORT [--force]   stop what holds it (TCP), and say how it went
#
# It reads /proc (the kernel's socket tables, and the processes that are
# yours), asks Podman or Docker which container a published port belongs
# to, and systemd which unit a socket of yours is. It sends nothing
# anywhere. Run as `python3 -I`: only Python's own library.

import errno
import ipaddress
import json
import os
import signal
import socket
import subprocess
import sys
import time

ME = os.getuid()
HOME = os.path.expanduser("~")

# --- the kernel's socket tables ------------------------------------------------------

TCP_LISTEN = "0A"
UDP_UNCONNECTED = "07"


def _ip(hexaddr):
    raw = bytes.fromhex(hexaddr)
    if len(raw) == 4:
        return str(ipaddress.IPv4Address(raw[::-1]))
    # IPv6: four 32-bit words, each in the host's (little-endian) order.
    words = b"".join(raw[i:i + 4][::-1] for i in range(0, 16, 4))
    ip = ipaddress.IPv6Address(words)
    return str(ip.ipv4_mapped) if ip.ipv4_mapped else str(ip)


def sockets(proto="tcp", every_state=False):
    """Yield (address, port, state, uid, inode) of the table's sockets."""
    for suffix in ("", "6"):
        try:
            with open(f"/proc/net/{proto}{suffix}") as f:
                next(f)
                for line in f:
                    parts = line.split()
                    if len(parts) < 10:
                        continue
                    local, remote, state = parts[1], parts[2], parts[3]
                    if not every_state:
                        if proto == "tcp" and state != TCP_LISTEN:
                            continue
                        if proto == "udp" and (state != UDP_UNCONNECTED or not remote.endswith(":0000")):
                            continue
                    addr, port = local.rsplit(":", 1)
                    yield _ip(addr), int(port, 16), state, int(parts[7]), int(parts[9])
        except (FileNotFoundError, PermissionError):
            continue


# --- processes -------------------------------------------------------------------------

try:
    TICKS = os.sysconf("SC_CLK_TCK")
except (ValueError, OSError):
    TICKS = 100


def _boot_time():
    try:
        with open("/proc/stat") as f:
            for line in f:
                if line.startswith("btime "):
                    return int(line.split()[1])
    except OSError:
        pass
    return 0


BOOT = _boot_time()


def proc(pid):
    """What a process is: its name, arguments, folder, parent, start, owner."""
    try:
        with open(f"/proc/{pid}/stat") as f:
            stat = f.read()
        uid = os.stat(f"/proc/{pid}").st_uid
    except OSError:
        return None
    comm = stat[stat.index("(") + 1:stat.rindex(")")]
    fields = stat[stat.rindex(")") + 2:].split()
    info = {"pid": pid, "comm": comm, "ppid": int(fields[1]), "start": int(fields[19]), "uid": uid,
            "argv": [], "cwd": ""}
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            info["argv"] = [a.decode(errors="replace") for a in f.read().split(b"\0") if a]
    except OSError:
        pass
    try:
        info["cwd"] = os.readlink(f"/proc/{pid}/cwd")
    except OSError:
        pass
    return info


def owners(inodes):
    """inode -> pid, for the sockets of processes that are yours."""
    found = {}
    if not inodes:
        return found
    want = {f"socket:[{i}]": i for i in inodes}
    for entry in os.scandir("/proc"):
        if not entry.name.isdigit():
            continue
        try:
            if entry.stat().st_uid != ME:
                continue
            fds = os.scandir(f"/proc/{entry.name}/fd")
        except OSError:
            continue
        with fds:
            for fd in fds:
                try:
                    link = os.readlink(fd.path)
                except OSError:
                    continue
                if link in want:
                    found.setdefault(want[link], int(entry.name))
        if len(found) == len(want):
            break
    return found


# What a process is to a person: the tool, not the interpreter running it.
TOOLS = {
    "vite", "next", "next-server", "nuxt", "nuxi", "astro", "remix", "webpack", "webpack-dev-server",
    "react-scripts", "expo", "metro", "storybook", "svelte-kit", "ng", "parcel", "esbuild", "wrangler",
    "json-server", "live-server", "http-server", "serve", "nodemon", "tsx", "ts-node", "vitest",
    "uvicorn", "gunicorn", "hypercorn", "daphne", "flask", "streamlit", "gradio", "jupyter",
    "jupyter-lab", "jupyter-notebook", "mkdocs", "hugo", "jekyll", "rails", "puma", "rackup",
    "artisan", "ollama", "caddy", "nginx", "air", "bun", "deno", "turbo",
}
SCRIPT_ENDS = (".js", ".mjs", ".cjs", ".ts", ".py", ".dll", ".exe", ".jar", ".rb")


def _base(arg):
    b = os.path.basename(arg)
    for end in SCRIPT_ENDS:
        if b.endswith(end):
            return b[: -len(end)]
    return b


def name_of(p):
    argv, comm = p["argv"], p["comm"]
    if not argv:
        return comm
    tool = _base(argv[0])
    if tool.startswith("python"):
        if "-m" in argv[:4]:
            i = argv.index("-m")
            if i + 1 < len(argv):
                return argv[i + 1].split(".")[0] if argv[i + 1] != "http.server" else "http.server"
        if len(argv) > 2 and _base(argv[1]) == "manage" and "runserver" in argv:
            return "django"
    if tool == "dotnet" and len(argv) > 1:
        if argv[1] == "watch":
            return "dotnet watch"
        if argv[1].endswith(".dll"):
            return _base(argv[1])
    if tool == "java" and "-jar" in argv:
        i = argv.index("-jar")
        if i + 1 < len(argv):
            return _base(argv[i + 1])
    if tool == "php" and len(argv) > 1 and _base(argv[1]) == "artisan":
        return "laravel"
    for arg in argv[:6]:
        b = _base(arg)
        if b in TOOLS:
            return b
    # The program's own name: the kernel's is cut at 15 characters, and some
    # rename themselves (node-MainThread).
    return tool or comm


def short_cmd(argv):
    """The command, readable: your home as ~, long paths cut to their name."""
    out = []
    for a in argv[:8]:
        if a.startswith(HOME):
            a = "~" + a[len(HOME):]
        if "/" in a and len(a) > 40:
            a = "…/" + os.path.basename(a.rstrip("/"))
        out.append(a)
    return " ".join(out) + (" …" if len(argv) > 8 else "")


# What marks a project's folder: the nearest one going up from where a
# server was started, up to your home.
MARKERS = (".git", "package.json", "Cargo.toml", "go.mod", "pyproject.toml", "Gemfile", "composer.json",
           "deno.json", "pom.xml", "build.gradle", "build.gradle.kts", "mix.exs", "Pipfile",
           "requirements.txt", "manage.py")
MARKER_ENDS = (".sln", ".slnx", ".csproj", ".fsproj")


def project_of(cwd):
    if not cwd or not cwd.startswith(HOME + "/"):
        return "", ""
    d = cwd
    while d.startswith(HOME + "/"):
        try:
            names = os.listdir(d)
        except OSError:
            names = []
        if any(m in names for m in MARKERS) or any(n.endswith(MARKER_ENDS) for n in names):
            return os.path.basename(d), "~" + d[len(HOME):]
        d = os.path.dirname(d)
    return "", ""


# --- who restarts a server -------------------------------------------------------------

# Never signalled: where you typed the command, and what runs your session.
KEEP = {"bash", "zsh", "fish", "sh", "dash", "nu", "ksh", "tcsh", "csh", "xonsh", "elvish", "tmux",
        "tmux: server", "screen", "zellij", "systemd", "init", "login", "sshd", "su", "sudo", "doas",
        "uwsm", "Hyprland", "foot", "kitty", "alacritty", "ghostty", "wezterm", "wezterm-gui",
        "konsole", "gnome-terminal-", "xterm", "code", "electron", "qs", "quickshell", "mazapan"}
WATCHERS = {"nodemon", "dotnet watch", "cargo-watch", "watchexec", "air", "entr", "reflex",
            "ts-node-dev", "tsx", "next", "nuxi", "nuxt", "astro", "turbo"}


def _watches(p, child):
    name = name_of(p)
    argv = p["argv"]
    if p["comm"] in KEEP or p["uid"] != ME:
        return False
    if name in WATCHERS or "--watch" in argv or "--reload" in argv or "watch" in argv[1:3]:
        return True
    # Werkzeug (Flask's reloader): the same command, one level up.
    return bool(child) and argv == child["argv"] and name_of(child).startswith(("python", "flask"))


def watcher_of(p):
    """The ancestor that would start the server again, if one does."""
    child, cur = p, proc(p["ppid"])
    for _ in range(4):
        if not cur or cur["pid"] <= 1:
            return None
        if cur["comm"] in KEEP:
            # `sh -c "vite"` (what npm runs) is on the way, not where you typed.
            if cur["comm"] in ("sh", "bash", "dash") and "-c" in cur["argv"][:3]:
                child, cur = cur, proc(cur["ppid"])
                continue
            return None
        if _watches(cur, child):
            return cur
        child, cur = cur, proc(cur["ppid"])
    return None


# --- containers and units --------------------------------------------------------------

FORWARDERS = {"pasta", "pasta.avx2", "passt", "passt.avx2", "rootlessport", "rootlessport-child",
              "slirp4netns", "conmon"}


def forwards(p):
    """Podman's helper that holds a container's published ports (pasta, rootlessport)."""
    return bool(p) and (p["comm"] in FORWARDERS or bool(p["argv"]) and _base(p["argv"][0]) in FORWARDERS)
COMPOSE = ("com.docker.compose.project", "io.podman.compose.project")
DEVDB = {"postgres": "PostgreSQL", "mysql": "MySQL", "redis": "Redis", "sqlserver": "SQL Server",
         "mongodb": "MongoDB"}


def _run(cmd, timeout=5):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout,
                           env={"PATH": "/usr/bin:/bin", "HOME": HOME, "LANG": "C.UTF-8",
                                "XDG_RUNTIME_DIR": os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{ME}")})
        return r.returncode, r.stdout, r.stderr
    except (OSError, subprocess.SubprocessError):
        return 1, "", ""


def _docker():
    """Docker itself (not Mazapan's `docker` that runs Podman), when you can reach it."""
    exe = "/usr/bin/docker"
    if not os.path.exists(exe) or "podman" in os.path.realpath(exe):
        return None
    sock = "/var/run/docker.sock"
    if not os.path.exists(sock) or not os.access(sock, os.R_OK | os.W_OK):
        return None
    return exe


def _container(engine, cid, name, image, labels, ports):
    labels = labels or {}
    project = next((labels[k] for k in COMPOSE if labels.get(k)), "")
    devdb = labels.get("mazapan.devdb", "")
    return {"engine": engine, "id": cid, "name": name, "image": image, "project": project,
            "devdb": DEVDB.get(devdb, ""), "ports": ports}


def containers(podman=True, docker=True):
    """Running containers and the ports they publish: [(host_ip, port, proto), …]."""
    out = []
    if podman and os.path.exists("/usr/bin/podman"):
        code, text, _ = _run(["/usr/bin/podman", "ps", "--format", "json"])
        if code == 0:
            try:
                for c in json.loads(text or "[]"):
                    ports = []
                    for p in c.get("Ports") or []:
                        for i in range(max(1, p.get("range") or 1)):
                            ports.append((p.get("host_ip") or "", p["host_port"] + i, p.get("protocol", "tcp")))
                    names = c.get("Names") or [""]
                    out.append(_container("podman", c.get("Id", ""), names[0], c.get("Image", ""),
                                          c.get("Labels"), ports))
            except (ValueError, KeyError, TypeError):
                pass
    exe = _docker() if docker else None
    if exe:
        code, text, _ = _run([exe, "ps", "--format", "json"])
        if code == 0:
            for line in text.splitlines():
                try:
                    c = json.loads(line)
                except ValueError:
                    continue
                labels = dict(kv.split("=", 1) for kv in (c.get("Labels") or "").split(",") if "=" in kv)
                out.append(_container("docker", c.get("ID", ""), c.get("Names", ""), c.get("Image", ""),
                                      labels, _docker_ports(c.get("Ports") or "")))
    return out


def _docker_ports(text):
    """'0.0.0.0:8080->80/tcp, [::]:8080->80/tcp' -> [(ip, port, proto), …]."""
    ports = []
    for part in text.split(","):
        part = part.strip()
        if "->" not in part:
            continue
        host, inside = part.split("->", 1)
        proto = inside.rsplit("/", 1)[-1] if "/" in inside else "tcp"
        ip, _, hp = host.rpartition(":")
        ip = ip.strip("[]")
        lo, _, hi = hp.partition("-")
        try:
            for port in range(int(lo), int(hi or lo) + 1):
                ports.append((ip, port, proto))
        except ValueError:
            continue
    return ports


def user_sockets():
    """'127.0.0.1:47318' -> ('x.socket', 'x.service'), for your systemd units."""
    code, text, _ = _run(["/usr/bin/systemctl", "--user", "list-sockets", "--no-legend", "--no-pager", "--full"])
    units = {}
    if code != 0:
        return units
    for line in text.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[1].endswith(".socket"):
            units[parts[0]] = (parts[1], parts[2] if len(parts) > 2 else "")
    return units


# --- reach ---------------------------------------------------------------------------------

TAILSCALE = (ipaddress.ip_network("100.64.0.0/10"), ipaddress.ip_network("fd7a:115c:a1e0::/48"))
VPN_LINKS = ("tailscale", "wg", "tun", "nb-", "zt", "netbird", "ts")


def vpn_addresses():
    code, text, _ = _run(["/usr/bin/ip", "-j", "addr", "show"])
    found = set()
    if code != 0:
        return found
    try:
        for link in json.loads(text):
            if link.get("ifname", "").startswith(VPN_LINKS):
                found.update(a.get("local", "") for a in link.get("addr_info", []))
    except ValueError:
        pass
    return found


def reach_of(addrs, vpn):
    """local: this computer alone; vpn: your private network alone; network: anyone near."""
    reach = "local"
    for a in addrs:
        try:
            ip = ipaddress.ip_address(a)
        except ValueError:
            return "network"
        if ip.is_loopback:
            continue
        if ip.is_unspecified:
            return "network"
        if a in vpn or any(ip in n for n in TAILSCALE if ip.version == n.version):
            reach = "vpn"
            continue
        return "network"
    return reach


def firewall_on():
    code, _, _ = _run(["/usr/bin/systemctl", "is-active", "--quiet", "ufw.service"], timeout=3)
    return code == 0


# Who usually listens on a port, for sockets whose process can't be seen (root's,
# another user's): said as a guess.
SERVICES = {
    22: "SSH", 25: "SMTP", 53: "DNS", 67: "DHCP", 80: "HTTP", 111: "rpcbind", 123: "NTP", 137: "Samba",
    139: "Samba", 443: "HTTPS", 445: "Samba", 631: "CUPS", 1433: "SQL Server", 1716: "KDE Connect",
    2375: "Docker", 2376: "Docker", 3306: "MySQL", 3389: "Remote Desktop", 5353: "mDNS", 5355: "LLMNR",
    5432: "PostgreSQL", 5900: "VNC", 6379: "Redis", 8384: "Syncthing", 9090: "Cockpit", 9100: "Printer",
    11434: "Ollama", 22000: "Syncthing", 27017: "MongoDB", 41641: "Tailscale", 53317: "LocalSend",
}


# --- every listener ------------------------------------------------------------------------

def scan(udp=False):
    raw = [(proto,) + s for proto in (("tcp", "udp") if udp else ("tcp",)) for s in sockets(proto)]
    mine = {inode for _, _, _, _, uid, inode in raw if uid == ME}
    pids = owners(mine)
    procs = {}

    def P(pid):
        if pid not in procs:
            procs[pid] = proc(pid)
        return procs[pid]

    forwarded = any(forwards(P(pids[i])) for i in mine if i in pids)
    boxes = containers(podman=forwarded)
    by_port = {}
    for c in boxes:
        for ip, port, proto in c["ports"]:
            by_port.setdefault((port, proto), c)
    # Your systemd units' sockets: systemd holds them, and its descriptors
    # can't be read, so they're known by their address.
    units = user_sockets() if any(uid == ME and i not in pids for *_, uid, i in raw) else {}

    def unit_at(port):
        return next((u for a, u in units.items() if a.rsplit(":", 1)[-1] == str(port)), None)

    groups = {}
    for proto, addr, port, _, uid, inode in raw:
        pid = pids.get(inode)
        p = P(pid) if pid else None
        box = by_port.get((port, proto))
        if box and (uid != ME or forwards(p) or not p):
            key = ("container", box["id"], port, proto)
        elif uid == ME and (not p or p["comm"] == "systemd") and unit_at(port):
            key = ("unit", 0, port, proto)
        elif uid == ME and p:
            key = ("mine", pid, port, proto)
        else:
            key = ("system", uid, port, proto)
        g = groups.setdefault(key, {"addrs": [], "pid": pid, "box": box, "uid": uid})
        if addr not in g["addrs"]:
            g["addrs"].append(addr)

    # A container whose port has no socket here (Docker without its proxy):
    # still listed, by what the engine says.
    for c in boxes:
        for ip, port, proto in c["ports"]:
            if proto == "udp" and not udp:
                continue
            key = ("container", c["id"], port, proto)
            if key not in groups:
                groups[key] = {"addrs": [ip or "0.0.0.0"], "pid": None, "box": c, "uid": ME}

    specific = any(not ipaddress.ip_address(a).is_loopback and not ipaddress.ip_address(a).is_unspecified
                   for g in groups.values() for a in g["addrs"])
    vpn = vpn_addresses() if specific else set()
    shield = firewall_on()

    listeners = []
    for (kind, _, port, proto), g in groups.items():
        item = {"port": port, "proto": proto, "addrs": sorted(g["addrs"]), "kind": kind, "name": "",
                "guess": False, "pid": 0, "cmd": "", "cwd": "", "project": "", "path": "", "since": 0,
                "watcher": "", "container": None, "unit": ""}
        item["reach"] = reach_of(g["addrs"], vpn)
        p = P(g["pid"]) if g["pid"] else None
        if kind == "container":
            c = g["box"]
            item["container"] = {k: c[k] for k in ("engine", "id", "name", "image", "project", "devdb")}
            item["name"] = c["devdb"] or c["name"]
            item["project"] = c["project"]
        elif kind == "unit":
            hit = unit_at(port)
            item["unit"] = hit[0] if hit else ""
            item["name"] = (hit[1] or hit[0]).rsplit(".", 1)[0] if hit else "systemd"
        elif kind == "mine":
            item["name"] = name_of(p)
            item["pid"] = p["pid"]
            item["cmd"] = short_cmd(p["argv"])
            item["cwd"] = ("~" + p["cwd"][len(HOME):]) if p["cwd"].startswith(HOME) else p["cwd"]
            item["project"], item["path"] = project_of(p["cwd"])
            item["since"] = BOOT + p["start"] // TICKS if BOOT else 0
            w = watcher_of(p)
            item["watcher"] = name_of(w) if w else ""
        else:
            item["name"] = SERVICES.get(port, "")
            item["guess"] = bool(item["name"])
        # How far it's reachable, the firewall counted: Docker's published
        # ports go around it (its own rules come first); Podman's don't.
        if item["reach"] != "network":
            item["exposure"] = ""
        elif kind == "container" and item["container"]["engine"] == "docker":
            item["exposure"] = "open"
        else:
            item["exposure"] = "firewall" if shield else "open"
        item["url"] = url_of(port, item["addrs"]) if proto == "tcp" else ""
        listeners.append(item)

    order = {"mine": 0, "container": 1, "unit": 2, "system": 3}
    listeners.sort(key=lambda i: (order[i["kind"]], i["port"], i["proto"]))
    return {"listeners": listeners, "firewall": shield, "at": int(time.time())}


def url_of(port, addrs):
    for a in addrs:
        ip = ipaddress.ip_address(a)
        if ip.is_loopback or ip.is_unspecified:
            return f"http://localhost:{port}"
    a = addrs[0]
    return f"http://[{a}]:{port}" if ":" in a else f"http://{a}:{port}"


# --- is it free ----------------------------------------------------------------------------

EPHEMERAL = (32768, 60999)
try:
    with open("/proc/sys/net/ipv4/ip_local_port_range") as _f:
        EPHEMERAL = tuple(int(x) for x in _f.read().split())
except (OSError, ValueError):
    pass


def bindable(port):
    """True if a server of yours could listen there now; 'root' if it's a port
    only root may take; False if something holds it."""
    for family, addr in ((socket.AF_INET6, "::"), (socket.AF_INET, "0.0.0.0")):
        try:
            s = socket.socket(family, socket.SOCK_STREAM)
        except OSError:
            continue
        try:
            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            if family == socket.AF_INET6:
                s.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 0)
            s.bind((addr, port))
            return True
        except PermissionError:
            return "root"
        except OSError as e:
            if e.errno == errno.EADDRINUSE:
                return False
            continue
        finally:
            s.close()
    return False


def next_free(port, taken=()):
    for p in range(port + 1, min(port + 400, 65536)):
        if EPHEMERAL[0] <= p <= EPHEMERAL[1] or p in taken:
            continue
        if bindable(p) is True:
            return p
    return 0


def check(port):
    state = bindable(port)
    every = scan()["listeners"]
    taken = {i["port"] for i in every}
    return {"port": port, "free": state is True, "root": state == "root",
            "holders": [i for i in every if i["port"] == port],
            "next": next_free(port, taken) if state is not True else 0}


# --- stopping --------------------------------------------------------------------------------

def _signal(p, sig):
    """Signal exactly this process: a pidfd opened first, then checked to be the
    same process (yours, started when it was), so a reused pid can't be hit."""
    try:
        fd = os.pidfd_open(p["pid"])
    except OSError:
        return False
    try:
        now = proc(p["pid"])
        if not now or now["start"] != p["start"] or now["uid"] != ME:
            return False
        signal.pidfd_send_signal(fd, sig)
        return True
    except OSError:
        return False
    finally:
        os.close(fd)


def _held(port):
    return any(p == port for _, p, _, _, _ in sockets("tcp"))


def stop(port, force=False):
    targets = [i for i in scan()["listeners"] if i["port"] == port and i["proto"] == "tcp"]
    if not targets:
        return {"port": port, "result": "free"}
    first = targets[0]
    out = {"port": port, "name": first["name"], "project": first["project"], "kind": first["kind"]}

    others = [i for i in targets if i["kind"] == "system"]
    if others and len(others) == len(targets):
        return dict(out, result="not-yours")

    for i in targets:
        if i["kind"] == "container":
            c = i["container"]
            exe = "/usr/bin/podman" if c["engine"] == "podman" else _docker()
            if not exe:
                return dict(out, result="failed")
            code, _, err = _run([exe, "kill" if force else "stop", c["id"]], timeout=30)
            if code != 0:
                return dict(out, result="failed", error=(err.strip().splitlines() or [""])[-1])
        elif i["kind"] == "unit" and i["unit"]:
            code, _, _ = _run(["/usr/bin/systemctl", "--user", "stop", i["unit"]], timeout=20)
            svc = i["unit"][: -len(".socket")] + ".service"
            _run(["/usr/bin/systemctl", "--user", "stop", svc], timeout=20)
            if code != 0:
                return dict(out, result="failed")
        elif i["kind"] == "mine":
            p = proc(i["pid"])
            if not p:
                continue
            sig = signal.SIGKILL if force else signal.SIGTERM
            w = watcher_of(p)
            if w:
                _signal(w, sig)
                out["watcher"] = name_of(w)
            _signal(p, sig)

    # Said only once the port is seen free, and still free a moment later
    # (something that starts it again would have by then).
    deadline = time.time() + (2 if force else 5)
    while time.time() < deadline and _held(port):
        time.sleep(0.1)
    if _held(port):
        return dict(out, result="held")
    time.sleep(1.2)
    if _held(port):
        back = [i for i in scan()["listeners"] if i["port"] == port]
        return dict(out, result="back", by=back[0]["name"] if back else "")
    return dict(out, result="freed")


# --- the command ---------------------------------------------------------------------------

def _port(arg):
    try:
        p = int(arg)
    except ValueError:
        p = 0
    if not 0 < p < 65536:
        sys.exit("ports: a port is a number from 1 to 65535")
    return p


def main(argv):
    if not argv:
        sys.exit("usage: ports list [--udp] | check PORT | stop PORT [--force]")
    cmd, rest = argv[0], argv[1:]
    if cmd == "list":
        result = scan(udp="--udp" in rest)
    elif cmd == "check" and rest:
        result = check(_port(rest[0]))
    elif cmd == "stop" and rest:
        result = stop(_port(rest[0]), force="--force" in rest)
    else:
        sys.exit("usage: ports list [--udp] | check PORT | stop PORT [--force]")
    json.dump(result, sys.stdout, ensure_ascii=False, separators=(",", ":"))
    sys.stdout.write("\n")


if __name__ == "__main__":
    main(sys.argv[1:])
